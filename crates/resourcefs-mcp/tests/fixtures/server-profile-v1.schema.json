              "type": "string"
            },
            "kind": {
              "const": "downstreamMcp",
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "servers": {
              "items": {
                "$ref": "#/$defs/DownstreamServerProfile"
              },
              "maxItems": 4096,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "servers"
          ],
          "type": "object"
        }
      ]
    },
    "SshHostProfile": {
      "additionalProperties": false,
      "description": "One SSH config alias and its contained remote roots.",
      "properties": {
        "alias": {
          "type": "string"
        },
        "remoteRoots": {
          "items": {
            "type": "string"
          },
          "maxItems": 4096,
          "type": "array"
        }
      },
      "required": [
        "alias",
        "remoteRoots"
      ],
      "type": "object"
    },
    "VaultProfile": {
      "additionalProperties": false,
      "description": "One named vault with optional narrower grants.",
      "properties": {
        "grants": {
          "$ref": "#/$defs/MutationGrantsProfile"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "type": "object"
    },
    "WorkspaceProfile": {
      "additionalProperties": false,
      "description": "Workspace Roots supplied by the operator profile.",
      "properties": {
        "backingPathVisibility": {
          "$ref": "#/$defs/BackingPathVisibilityProfile",
          "description": "Whether normal results may expose backing file URIs."
        },
        "primaryRoot": {
          "description": "Stable ID of the Primary Workspace Root.",
          "type": "string"
        },
        "roots": {
          "description": "Launch roots; an absent list means no launch Workspace authority.",
          "items": {
            "$ref": "#/$defs/WorkspaceRootProfile"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "type": "object"
    },
