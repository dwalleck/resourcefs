            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "kind": {
              "const": "memory",
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "roots": {
              "items": {
                "$ref": "#/$defs/NamedPathProfile"
              },
              "maxItems": 4096,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "roots"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Named Obsidian vaults.",
          "properties": {
            "grants": {
              "$ref": "#/$defs/MutationGrantsProfile"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "kind": {
              "const": "vault",
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "vaults": {
              "items": {
                "$ref": "#/$defs/VaultProfile"
              },
              "maxItems": 4096,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "vaults"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Imported public Agent Export manifests.",
          "properties": {
            "grants": {
              "additionalProperties": false,
              "description": "Independent create, update, and delete grants supported by this source.",
              "properties": {
                "create": {
                  "const": false,
                  "description": "Permit creation when true.",
                  "type": "boolean"
                },
                "delete": {
                  "const": false,
                  "description": "Permit deletion when true.",
                  "type": "boolean"
                },
                "update": {
                  "const": false,
