{
  "$defs": {
    "BackingPathVisibilityProfile": {
      "description": "Backing-path disclosure policy.",
      "oneOf": [
        {
          "const": "hidden",
          "description": "Keep backing filesystem paths private.",
          "type": "string"
        },
        {
          "const": "visible",
          "description": "Include backing file URI metadata.",
          "type": "string"
        }
      ]
    },
    "CommandProfile": {
      "additionalProperties": false,
      "description": "Strict direct-argv subprocess definition.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentValueProfile"
          },
          "maxProperties": 256,
          "type": "object"
        }
      },
      "required": [
        "argv"
      ],
      "type": "object"
    },
    "ConverterInputProfile": {
      "description": "Converter input delivery mode.",
      "enum": [
        "stdin",
        "path"
      ],
      "type": "string"
    },
    "CredentialHeaderProfile": {
      "additionalProperties": false,
      "description": "Credential header resolved at process startup.",
      "properties": {
        "header": {
          "type": "string"
        },
        "scheme": {
          "type": "string"
        },
        "secret": {
          "$ref": "#/$defs/SecretReferenceProfile"
        }
      },
      "required": [
        "header",
        "secret"
      ],
      "type": "object"
    },
    "DocumentConverterProfile": {
      "additionalProperties": false,
      "description": "One extension-owned direct converter.",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandProfile"
        },
        "extensions": {
          "items": {
            "type": "string"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "input": {
          "$ref": "#/$defs/ConverterInputProfile"
        }
      },
      "required": [
        "extensions",
        "input",
        "command"
      ],
      "type": "object"
    },
    "DownstreamServerProfile": {
      "additionalProperties": false,
      "description": "One downstream server and its native URI scheme claims.",
      "properties": {
        "id": {
          "type": "string"
        },
        "schemes": {
          "items": {
            "type": "string"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "transport": {
          "$ref": "#/$defs/DownstreamTransportProfile"
        }
      },
      "required": [
        "id",
        "schemes",
        "transport"
      ],
      "type": "object"
    },
    "DownstreamTransportProfile": {
      "description": "Supported downstream MCP transport.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "$ref": "#/$defs/CommandProfile"
            },
            "kind": {
              "const": "stdio",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowPrivateNetwork": {
              "type": "boolean"
            },
            "credential": {
              "$ref": "#/$defs/CredentialHeaderProfile"
            },
            "endpoint": {
              "type": "string"
            },
            "kind": {
              "const": "http",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "endpoint",
            "allowPrivateNetwork"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentValueProfile": {
      "description": "Explicit subprocess environment mapping.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "literal",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inherit",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "secret",
              "type": "string"
            },
            "secret": {
              "$ref": "#/$defs/SecretReferenceProfile"
            }
          },
          "required": [
            "kind",
            "secret"
          ],
          "type": "object"
        }
      ]
    },
    "GithubRepositoryProfile": {
      "additionalProperties": false,
      "description": "One allowlisted GitHub repository.",
      "properties": {
        "grants": {
          "additionalProperties": false,
          "description": "Independent create, update, and delete grants supported by this source.",
          "properties": {
            "create": {
              "description": "Permit creation when true.",
              "type": "boolean"
            },
            "delete": {
              "const": false,
              "description": "Permit deletion when true.",
              "type": "boolean"
            },
            "update": {
              "description": "Permit replacement and editing when true.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "HttpsOriginProfile": {
      "additionalProperties": false,
      "description": "One authorized HTTPS base URL prefix.",
      "properties": {
        "allowPrivateNetwork": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string"
        },
        "credential": {
          "$ref": "#/$defs/CredentialHeaderProfile"
        }
      },
      "required": [
        "baseUrl",
        "allowPrivateNetwork"
      ],
      "type": "object"
    },
    "LimitsProfile": {
      "additionalProperties": false,
      "description": "Lower-only server ceilings.",
      "properties": {
        "imageBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "listingEntries": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "objectBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "processConcurrency": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "sessionBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "textBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "textColumns": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "textLines": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "LogDestinationProfile": {
      "description": "Diagnostic output destination.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "stderr",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "file",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "retainFiles": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "rotationBytes": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "LogLevelProfile": {
      "description": "Diagnostic severity floor.",
      "enum": [
        "error",
        "warn",
        "info",
        "debug"
      ],
      "type": "string"
    },
    "LoggingProfile": {
      "additionalProperties": false,
      "description": "Bounded off-protocol logging configuration.",
      "properties": {
        "destination": {
          "$ref": "#/$defs/LogDestinationProfile"
        },
        "level": {
          "$ref": "#/$defs/LogLevelProfile"
        }
      },
      "type": "object"
    },
    "MutationGrantsProfile": {
      "additionalProperties": false,
      "description": "Independent create, update, and delete grants.",
      "properties": {
        "create": {
          "description": "Permit creation when true.",
          "type": "boolean"
        },
        "delete": {
          "description": "Permit deletion when true.",
          "type": "boolean"
        },
        "update": {
          "description": "Permit replacement and editing when true.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "NamedPathProfile": {
      "additionalProperties": false,
      "description": "A stable Resource name mapped to a contained path.",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "type": "object"
    },
    "SecretReferenceProfile": {
      "description": "Opaque environment or helper-command secret reference.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "environment",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "$ref": "#/$defs/CommandProfile"
            },
            "kind": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "SessionProfile": {
      "additionalProperties": false,
      "description": "Retained Path Session configuration.",
      "properties": {
        "cacheDirectory": {
          "type": "string"
        },
        "retentionTtlSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "SourceProfile": {
      "description": "One strict Portable Source configuration.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "HTTPS allowlist source.",
          "properties": {
            "grants": {
              "additionalProperties": false,
              "description": "Independent create, update, and delete grants supported by this source.",
              "properties": {
                "create": {
                  "const": false,
                  "description": "Permit creation when true.",
                  "type": "boolean"
                },
                "delete": {
                  "const": false,
                  "description": "Permit deletion when true.",
                  "type": "boolean"
                },
                "update": {
                  "const": false,
                  "description": "Permit replacement and editing when true.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "kind": {
              "const": "https",
              "type": "string"
            },
            "origins": {
              "items": {
                "$ref": "#/$defs/HttpsOriginProfile"
              },
              "maxItems": 4096,
              "type": "array"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "origins"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "GitHub repository source.",
          "properties": {
            "allowPrivateNetwork": {
              "type": "boolean"
            },
            "apiBaseUrl": {
              "type": "string"
            },
            "credential": {
              "$ref": "#/$defs/SecretReferenceProfile"
            },
            "grants": {
              "additionalProperties": false,
              "description": "Independent create, update, and delete grants supported by this source.",
              "properties": {
                "create": {
                  "description": "Permit creation when true.",
                  "type": "boolean"
                },
                "delete": {
                  "const": false,
                  "description": "Permit deletion when true.",
                  "type": "boolean"
                },
                "update": {
                  "description": "Permit replacement and editing when true.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "kind": {
              "const": "github",
              "type": "string"
            },
            "repositories": {
              "items": {
                "$ref": "#/$defs/GithubRepositoryProfile"
              },
              "maxItems": 4096,
              "type": "array"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "allowPrivateNetwork",
            "credential",
            "repositories"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Read-only SSH source.",
          "properties": {
            "command": {
              "$ref": "#/$defs/CommandProfile"
            },
            "grants": {
              "additionalProperties": false,
              "description": "Independent create, update, and delete grants supported by this source.",
              "properties": {
                "create": {
                  "const": false,
                  "description": "Permit creation when true.",
                  "type": "boolean"
                },
                "delete": {
                  "const": false,
                  "description": "Permit deletion when true.",
                  "type": "boolean"
                },
                "update": {
                  "const": false,
                  "description": "Permit replacement and editing when true.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "hosts": {
              "items": {
                "$ref": "#/$defs/SshHostProfile"
              },
              "maxItems": 4096,
              "type": "array"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "kind": {
              "const": "ssh",
              "type": "string"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "command",
            "hosts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Document converter source.",
          "properties": {
            "converters": {
              "items": {
                "$ref": "#/$defs/DocumentConverterProfile"
              },
              "maxItems": 4096,
              "type": "array"
            },
            "grants": {
              "additionalProperties": false,
              "description": "Independent create, update, and delete grants supported by this source.",
              "properties": {
                "create": {
                  "const": false,
                  "description": "Permit creation when true.",
                  "type": "boolean"
                },
                "delete": {
                  "const": false,
                  "description": "Permit deletion when true.",
                  "type": "boolean"
                },
                "update": {
                  "const": false,
                  "description": "Permit replacement and editing when true.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "kind": {
              "const": "documents",
              "type": "string"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "converters"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Agent Skills roots.",
          "properties": {
            "grants": {
              "$ref": "#/$defs/MutationGrantsProfile"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "kind": {
              "const": "skills",
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "roots": {
              "items": {
                "type": "string"
              },
              "maxItems": 4096,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "roots"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native rules manifests.",
          "properties": {
            "grants": {
              "$ref": "#/$defs/MutationGrantsProfile"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "kind": {
              "const": "rules",
              "type": "string"
            },
            "manifests": {
              "items": {
                "type": "string"
              },
              "maxItems": 4096,
              "type": "array"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "required",
            "manifests"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Named read-only Memory roots.",
          "properties": {
            "grants": {
              "additionalProperties": false,
              "description": "Independent create, update, and delete grants supported by this source.",
              "properties": {
                "create": {
                  "const": false,
                  "description": "Permit creation when true.",
                  "type": "boolean"
                },
                "delete": {
                  "const": false,
                  "description": "Permit deletion when true.",
                  "type": "boolean"
                },
                "update": {
                  "const": false,
