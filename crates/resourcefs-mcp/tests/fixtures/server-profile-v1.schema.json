        {
          "additionalProperties": false,
          "description": "Downstream MCP Resource servers.",
          "properties": {
            "grants": {
              "additionalProperties": false,
              "description": "Independent create, update, and delete grants supported by this source.",
              "properties": {
                "create": {
                  "const": false,
                  "description": "Permit creation when true.",
                  "type": "boolean"
                },
                "delete": {
                  "const": false,
                  "description": "Permit deletion when true.",
                  "type": "boolean"
                },
